# Normalize line endings so cross-branch merges stop producing
# whole-file LF<->CRLF diffs (core.autocrlf=true writes CRLF into the tree).
*.dart text eol=lf
*.arb text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.arb.template text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
# Shell scripts must stay LF: a CRLF shebang makes the kernel look for
# "bash\r", which the runner answers with exit 127 and no message.
*.sh text eol=lf
*.bash text eol=lf
configure text eol=lf
# CMake and Python run on the Linux/macOS runners too.
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.py text eol=lf
# Xcode reads these as text; CRLF breaks the project and CocoaPods scripts.
*.pbxproj text eol=lf
Podfile text eol=lf
*.xcconfig text eol=lf
*.plist text eol=lf
*.storyboard text eol=lf
*.xib text eol=lf
*.entitlements text eol=lf
# linuxdeploy parses the desktop entry itself and rejects a trailing \r.
*.desktop text eol=lf
# Source the runners compile: MSVC and clang both accept CRLF, but gofmt,
# the Go toolchain and the Rust build tool assume LF.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.rs text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.java text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Remaining Xcode project files and Linux runner sources.
*.xcworkspacedata text eol=lf
*.xcsettings text eol=lf
*.xcscheme text eol=lf
*.modulemap text eol=lf
LICENSE text eol=lf
lib/services/http/rhttp/LICENSE text eol=lf
*.mobileprovision binary
*.cc text eol=lf
*.proto text eol=lf
PKGBUILD text eol=lf
README text eol=lf
*.podspec text eol=lf
*.rc text eol=lf
*.manifest text eol=lf
*.7z binary
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.tar binary
*.wasm binary
*.so binary
*.dll binary
*.dylib binary
*.a binary
*.lib binary
*.apk binary
*.aab binary
*.ipa binary
*.jar binary
*.pak binary
*.dat binary
*.pdf binary
*.lock text eol=lf
.dart_tool/ linguist-generated
*.g.dart text eol=lf linguist-generated
